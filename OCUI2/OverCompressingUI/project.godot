; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OverCompressing"
config/description="A window for OverCompressing (llm_archive.py), built on the Godot engine."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=8000
boot_splash/bg_color=Color(0.02, 0.027, 0.06, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"
config/windows_native_icon="res://icon.ico"

[display]

window/size/viewport_width=1280
window/size/viewport_height=820

[dotnet]

project/assembly_name="OverCompressingUI"

[gui]

theme/default_font_subpixel_positioning=0
theme/lcd_subpixel_layout=0
theme/custom="res://assets/theme.tres"

[rendering]

viewport/hdr_2d=true
anti_aliasing/quality/msaa_2d=1
environment/defaults/default_clear_color=Color(0.02, 0.027, 0.06, 1)
